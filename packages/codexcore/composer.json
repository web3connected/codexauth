{
    "name": "web3codex/codexcore",
    "description": "CodexCore - Base interfaces, contracts, middleware and utilities for Web3Connected Codex system",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Web3Connected",
            "email": "admin@web3connected.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Web3Codex\\CodexCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Web3Codex\\CodexCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Web3Codex\\CodexCore\\Providers\\CodexCoreServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
